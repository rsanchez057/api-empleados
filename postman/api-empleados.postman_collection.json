{
  "info": {
    "name": "API Empleados - TechNova",
    "description": "Pruebas de los endpoints GET, POST, PUT y DELETE de la API de empleados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. POST registrar empleado (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Ana María\",\n  \"apellidos\": \"López Pérez\",\n  \"cargo\": \"Analista de sistemas\",\n  \"salario\": 18500.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/empleados",
          "host": ["{{baseUrl}}"],
          "path": ["api", "empleados"]
        }
      }
    },
    {
      "name": "2. POST datos inválidos (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"\",\n  \"apellidos\": \"Pérez\",\n  \"cargo\": \"\",\n  \"salario\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/empleados",
          "host": ["{{baseUrl}}"],
          "path": ["api", "empleados"]
        }
      }
    },
    {
      "name": "3. GET listar empleados (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/empleados",
          "host": ["{{baseUrl}}"],
          "path": ["api", "empleados"]
        }
      }
    },
    {
      "name": "4. GET buscar por id (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/empleados/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "empleados", "1"]
        }
      }
    },
    {
      "name": "5. GET id inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/empleados/999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "empleados", "999"]
        }
      }
    },
    {
      "name": "6. PUT actualizar empleado (200)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Ana María\",\n  \"apellidos\": \"López Pérez\",\n  \"cargo\": \"Jefa de sistemas\",\n  \"salario\": 25000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/empleados/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "empleados", "1"]
        }
      }
    },
    {
      "name": "7. DELETE eliminar empleado (200)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/empleados/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "empleados", "1"]
        }
      }
    }
  ]
}
